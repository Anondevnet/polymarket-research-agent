# ---- Models -------------------------------------------------------------
# Embeddings: "hashing" (offline, deterministic, default), "sentence-transformers", or "openai"
PMRA_EMBEDDING_PROVIDER=hashing
PMRA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM: "heuristic" (offline lexicon baseline, default) or "openai" (any OpenAI-compatible API)
PMRA_LLM_PROVIDER=heuristic
PMRA_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint (Ollama, vLLM, xAI, Together...). Leave blank for OpenAI.
OPENAI_BASE_URL=

# ---- Vector store -------------------------------------------------------
# "qdrant" or "memory". For qdrant, PMRA_QDRANT_URL can be ":memory:", a local path, or http://host:6333
PMRA_VECTOR_STORE=qdrant
PMRA_QDRANT_URL=:memory:
PMRA_QDRANT_API_KEY=
PMRA_COLLECTION=pm_evidence
PMRA_HYBRID=true

# ---- Sources (comma-separated, pluggable) ---------------------------------
PMRA_SOURCES=google_news,gdelt

# ---- Tracing (all optional; no-op when unset) ----------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LangSmith traces LangGraph runs automatically when these are set:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pm-research-agent
# Generic OpenTelemetry export (requires the [tracing] extra)
OTEL_EXPORTER_OTLP_ENDPOINT=
PMRA_OTEL_CONSOLE=false
